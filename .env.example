# Server-only configuration. Never use VITE_ for API keys.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Confirm this model is available in your Google AI Studio Free Tier project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Billing is controlled by Google, not this file. Do not link a billing account.

# Optional Elice Serverless connection. To use it, set LLM_PROVIDER to elice and restart.
# Keep the Gemini values to switch back. This is not an automatic fallback.
ELICE_API_KEY=
ELICE_MODEL=gpt-4o-mini
# Model URL supplied in the Elice API tab; /v1 is also accepted (do not add /chat/completions).
ELICE_BASE_URL=https://mlapi.run/40cc17ae-a89b-4f12-a7d6-13293180fc87
# Education credits/limits must be checked with Elice. Issuing a key does not guarantee free use.
